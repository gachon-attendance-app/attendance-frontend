<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:orientation="vertical">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="45dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="125dp"
            android:layout_height="45dp"
            android:scaleType="fitStart"
            android:src="@drawable/nulogo" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:src="@drawable/menu"
            android:tint="#707070" />
    </LinearLayout>

    <!-- 제목 카드 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp">

        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:text="한 주 출결현황"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <!-- 주간 달력 카드 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="12dp">

            <TextView
                android:id="@+id/tvMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="2026 4월"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/btnPrevWeek"
                    android:layout_width="26dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="◀"
                    android:textColor="#999999"
                    android:textSize="18sp" />

                <!-- 일 -->
                <LinearLayout
                    android:id="@+id/dateSun"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSunLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="일"
                        android:textColor="#888888"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSunDate"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="31"
                        android:textColor="#B0B0B0"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- 월 -->
                <LinearLayout
                    android:id="@+id/dateMon"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="월"
                        android:textColor="#888888"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvMonDate"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#111111"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- 화 선택된 날짜 -->
                <LinearLayout
                    android:id="@+id/dateTue"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="화"
                        android:textColor="#888888"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvTueDate"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_date_selected_blue"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="#111111"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- 수 -->
                <LinearLayout
                    android:id="@+id/dateWed"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="수"
                        android:textColor="#888888"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvWedDate"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="#111111"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- 목 -->
                <LinearLayout
                    android:id="@+id/dateThu"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="목"
                        android:textColor="#888888"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvThuDate"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="4"
                        android:textColor="#111111"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- 금: 결석/지각 있는 날짜 -->
                <LinearLayout
                    android:id="@+id/dateFri"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="금"
                        android:textColor="#888888"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvFriDate"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_date_warning_red"
                        android:gravity="center"
                        android:text="5"
                        android:textColor="#111111"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- 토 -->
                <LinearLayout
                    android:id="@+id/dateSat"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="토"
                        android:textColor="#888888"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSatDate"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="6"
                        android:textColor="#111111"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnNextWeek"
                    android:layout_width="26dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#999999"
                    android:textSize="18sp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 출결 리스트 영역 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="18dp"
        android:layout_weight="1"
        app:cardBackgroundColor="#DDDDDF"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="2026.04.02"
                android:textColor="#004B83"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 아이템 1 결석 -->
            <LinearLayout
                android:id="@+id/itemAttendance1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_attendance_item"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent"
                    android:background="#008AE8" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:id="@+id/tvClassName1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="모바일 프로그래밍"
                        android:textColor="#004B83"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvClassTime1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◷ 11:00 ~ 11:50"
                        android:textColor="#666666"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatus1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="결석"
                    android:textColor="#D60000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivStatusIcon1"
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@drawable/absentweek"
                    android:contentDescription="결석 아이콘" />
            </LinearLayout>

            <!-- 아이템 2 출석 - 펼쳐진 상태 -->
            <LinearLayout
                android:id="@+id/itemAttendance2"
                android:layout_width="match_parent"
                android:layout_height="138dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_attendance_item"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent"
                    android:background="#008AE8" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <!-- 상단 기본 정보 -->
                    <LinearLayout
                        android:id="@+id/classSummaryArea"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvClassName2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="모바일 프로그래밍"
                                android:textColor="#004B83"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvClassTime2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="◷ 10:00 ~ 10:50"
                                android:textColor="#666666"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStatus2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="출석"
                            android:textColor="#004B83"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivStatusIcon2"
                            android:layout_width="42dp"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:src="@drawable/attendanceweek"
                            android:contentDescription="출석 아이콘" />                   </LinearLayout>

                    <!-- 구분선 -->
                    <View
                        android:id="@+id/detailDivider2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#DDDDDD" />

                    <!-- 상세 정보 -->
                    <LinearLayout
                        android:id="@+id/detailArea2"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="8dp">

                        <TextView
                            android:id="@+id/tvPreventTitle2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="중간 퇴장 방지 시스템"
                            android:textColor="#666666"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvCheckTime1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="10:00 - 10:15"
                                    android:textColor="#555555"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvCheckTime2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="10:20 - 10:25"
                                    android:textColor="#555555"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvCheckStatus1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="미출석"
                                    android:textColor="#555555"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvCheckStatus2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="미출석"
                                    android:textColor="#555555"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnCollapse2"
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:gravity="center"
                            android:text="▲"
                            android:textColor="#666666"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>


            <!-- 아이템 3 출석 -->
            <LinearLayout
                android:id="@+id/itemAttendance3"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_attendance_item"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent"
                    android:background="#008AE8" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:text="모바일 프로그래밍"
                        android:textColor="#004B83"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="◷ 12:00 ~ 12:50"
                        android:textColor="#666666"
                        android:textSize="11sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:text="출석"
                    android:textColor="#004B83"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/ivStatusIcon3"
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@drawable/attendanceweek"
                    android:contentDescription="출석 아이콘" />
            </LinearLayout>

            <!-- 아이템 4 지각 -->
            <LinearLayout
                android:id="@+id/itemAttendance4"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_attendance_item"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent"
                    android:background="#008AE8" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:text="소프트웨어공학"
                        android:textColor="#004B83"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="◷ 12:00 ~ 12:50"
                        android:textColor="#666666"
                        android:textSize="11sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:text="지각"
                    android:textColor="#9C00B8"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/ivStatusIcon4"
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@drawable/lateweek"
                    android:contentDescription="지각 아이콘" />
            </LinearLayout>

            <!-- 아이템 5 출석 -->
            <LinearLayout
                android:id="@+id/itemAttendance5"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_attendance_item"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent"
                    android:background="#008AE8" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:text="소프트웨어공학"
                        android:textColor="#004B83"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="◷ 12:00 ~ 12:50"
                        android:textColor="#666666"
                        android:textSize="11sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:text="출석"
                    android:textColor="#004B83"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/ivStatusIcon5"
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@drawable/attendanceweek"
                    android:contentDescription="출석 아이콘" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 하단 메뉴 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="#004B83"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBottomHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/home"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/retry"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomNotice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/bell"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomSchedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/calendar"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomLogout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/back"
            android:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>