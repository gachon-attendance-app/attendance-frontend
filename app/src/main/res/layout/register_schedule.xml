<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/registerScheduleRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:orientation="vertical">

    <!-- 상단 바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="98dp"
        android:background="@color/primarybase"
        android:gravity="center"
        android:paddingTop="34dp">

        <TextView
            android:id="@+id/tvRegisterTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:text="시간표 연동"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 스크롤 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/tvStudentScheduleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:text="최은수님의 시간표"
                android:textColor="@color/primarybase"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScheduleGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/pretendard_medium"
                android:text="백엔드에 등록된 과목코드를 입력하면 해당 수업 시간이 시간표에 자동으로 추가됩니다."
                android:textColor="#666666"
                android:textSize="12sp" />

            <!-- 시간표 카드 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="340dp"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:id="@+id/timeTableFrame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp">

                    <!-- 기본 시간표 그리드 -->
                    <TableLayout
                        android:id="@+id/tableScheduleGrid"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:stretchColumns="1,2,3,4,5">

                        <!-- 요일 헤더 -->
                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="24dp">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text=""
                                android:textColor="#888888"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="월"
                                android:textColor="#777777"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="화"
                                android:textColor="#777777"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="수"
                                android:textColor="#777777"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="목"
                                android:textColor="#777777"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="금"
                                android:textColor="#777777"
                                android:textSize="10sp" />
                        </TableRow>

                        <!-- 9시 -->
                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="52dp">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="match_parent"
                                android:gravity="top|center_horizontal"
                                android:text="9"
                                android:textColor="#777777"
                                android:textSize="10sp" />

                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                        </TableRow>

                        <!-- 10시 -->
                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="52dp">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="match_parent"
                                android:gravity="top|center_horizontal"
                                android:text="10"
                                android:textColor="#777777"
                                android:textSize="10sp" />

                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                        </TableRow>

                        <!-- 11시 -->
                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="52dp">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="match_parent"
                                android:gravity="top|center_horizontal"
                                android:text="11"
                                android:textColor="#777777"
                                android:textSize="10sp" />

                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                        </TableRow>

                        <!-- 12시 -->
                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="52dp">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="match_parent"
                                android:gravity="top|center_horizontal"
                                android:text="12"
                                android:textColor="#777777"
                                android:textSize="10sp" />

                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                        </TableRow>

                        <!-- 1시 -->
                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="52dp">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="match_parent"
                                android:gravity="top|center_horizontal"
                                android:text="1"
                                android:textColor="#777777"
                                android:textSize="10sp" />

                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                        </TableRow>

                        <!-- 2시 -->
                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="52dp">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="match_parent"
                                android:gravity="top|center_horizontal"
                                android:text="2"
                                android:textColor="#777777"
                                android:textSize="10sp" />

                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                            <TextView style="@style/TimeTableCell" />
                        </TableRow>
                    </TableLayout>

                    <!-- 과목 카드가 동적으로 추가되는 영역 -->
                    <!-- RegisterScheduleActivity.kt에서 과목명 + 강의실 TextView가 여기에 올라감 -->
                    <FrameLayout
                        android:id="@+id/classBlockLayer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="28dp"
                        android:paddingTop="24dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="0dp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- 수업 추가 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:fontFamily="@font/pretendard_bold"
                android:text="수업 추가"
                android:textColor="@color/primarybase"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCourseCode"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_box"
                android:fontFamily="@font/pretendard_medium"
                android:hint="과목 코드를 입력하세요"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnAddClass"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#7E9CC2"
                android:fontFamily="@font/pretendard_bold"
                android:text="과목 추가"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnConfirmSchedule"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/primarybase"
                android:fontFamily="@font/pretendard_bold"
                android:text="확인"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

    <!-- 하단 로고 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:background="#DDDDDF"
        android:gravity="center_vertical"
        android:paddingStart="24dp">

        <ImageView
            android:id="@+id/ivBottomLogo"
            android:layout_width="116dp"
            android:layout_height="42dp"
            android:scaleType="fitStart"
            android:src="@drawable/nulogo" />
    </LinearLayout>

</LinearLayout>