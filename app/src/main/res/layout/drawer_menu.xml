<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutDrawerMenu"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:background="#F1F2F4">

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="#005BAC" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="#F1F2F4">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="가천대학교"
            android:textSize="14sp"
            android:textColor="#005BAC"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="전자출결 메뉴"
            android:textSize="20sp"
            android:textColor="#111111"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D6D6D6" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="22dp"
            android:paddingTop="24dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="마이페이지"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/menuMyPage"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="마이페이지"
                android:textColor="#222222"
                android:textSize="17sp"
                android:paddingStart="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="출결현황"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/menuSchedule"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="시간표"
                android:textColor="#222222"
                android:textSize="17sp"
                android:paddingStart="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/menuWeekAttendance"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="주간 출결 현황"
                android:textColor="#222222"
                android:textSize="17sp"
                android:paddingStart="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/menuAllAttendance"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="전체 출결 현황"
                android:textColor="#222222"
                android:textSize="17sp"
                android:paddingStart="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="인증 결석"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/menuConfirmPeriod"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="생리공결"
                android:textColor="#222222"
                android:textSize="17sp"
                android:paddingStart="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/menuConfirmOfficial"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="유고결석"
                android:textColor="#222222"
                android:textSize="17sp"
                android:paddingStart="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="휴보강"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/menuNotice"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="강의공지"
                android:textColor="#222222"
                android:textSize="17sp"
                android:paddingStart="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/menuCancel"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:text="휴보강"
                android:textColor="#222222"
                android:textSize="17sp"
                android:paddingStart="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>