<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pinPopupCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="22dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="28dp"
        android:paddingEnd="26dp"
        android:paddingBottom="24dp">

        <!-- 상단 제목 -->
        <TextView
            android:id="@+id/tvPinPopupTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:gravity="center"
            android:text="PIN 출석 인증"
            android:textColor="@color/primarybase"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- 수업명 -->
        <TextView
            android:id="@+id/tvPinClassName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/pretendard_medium"
            android:gravity="center"
            android:text="모바일 프로그래밍"
            android:textColor="#333333"
            android:textSize="17sp" />

        <!-- 시간 안내 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/tabler_clock"
                android:tint="#555555" />

            <TextView
                android:id="@+id/tvPinClassTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/pretendard_medium"
                android:text="10:00 ~ 10:50"
                android:textColor="#555555"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 안내 박스 -->
        <LinearLayout
            android:id="@+id/pinGuideBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#F1F1F1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/tvPinGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:gravity="center"
                android:text="교수님이 안내한 PIN 4자리를 입력하세요."
                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- PIN 입력칸 4개 -->
            <LinearLayout
                android:id="@+id/pinInputArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPin1"
                    android:layout_width="50dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pin_box"
                    android:fontFamily="@font/pretendard_bold"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#111111"
                    android:textSize="28sp" />

                <EditText
                    android:id="@+id/etPin2"
                    android:layout_width="50dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pin_box"
                    android:fontFamily="@font/pretendard_bold"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#111111"
                    android:textSize="28sp" />

                <EditText
                    android:id="@+id/etPin3"
                    android:layout_width="50dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_pin_box"
                    android:fontFamily="@font/pretendard_bold"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#111111"
                    android:textSize="28sp" />

                <EditText
                    android:id="@+id/etPin4"
                    android:layout_width="50dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_pin_box"
                    android:fontFamily="@font/pretendard_bold"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#111111"
                    android:textSize="28sp" />
            </LinearLayout>

            <!-- 유효 시간 -->
            <TextView
                android:id="@+id/tvPinRemainTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/pretendard_medium"
                android:gravity="center"
                android:text="PIN 입력 가능 시간 07:00"
                android:textColor="#D00000"
                android:textSize="13sp" />

            <!-- 현재 처리 기준 안내 -->
            <TextView
                android:id="@+id/tvPinStatusGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/pretendard_medium"
                android:gravity="center"
                android:text="현재 PIN 인증 시 출석 처리됩니다."
                android:textColor="#777777"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- 오류/성공 메시지 -->
        <TextView
            android:id="@+id/tvPinResultMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/pretendard_medium"
            android:gravity="center"
            android:text=""
            android:textColor="#D00000"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- 버튼 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPinCancel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#D9D9D9"
                android:fontFamily="@font/pretendard_bold"
                android:text="닫기"
                android:textColor="#555555"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnPinConfirm"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/primarybase"
                android:fontFamily="@font/pretendard_bold"
                android:text="인증하기"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>