<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/noticeStudentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:orientation="vertical">

    <!-- 상단 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="130dp"
            android:layout_height="48dp"
            android:scaleType="fitStart"
            android:src="@drawable/nulogo" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/menu" />
    </LinearLayout>



    <!-- 메인 콘텐츠 -->
    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <!-- 제목 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/titleCard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvNoticeTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/pretendard_bold"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="강의 공지"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <!-- 흰색 큰 박스 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/noticeMainCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:id="@+id/noticeFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- 학생용 공지 목록 화면 -->
                <LinearLayout
                    android:id="@+id/studentNoticeListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- 내부 상단바 -->
                    <LinearLayout
                        android:id="@+id/noticeTopBar"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:background="#F2F5FA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/tvStudentNoticePageTitle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/pretendard_bold"
                            android:gravity="center_vertical"
                            android:text="공지사항"
                            android:textColor="#111111"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNoticeCount"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="#E4F2FF"
                            android:fontFamily="@font/pretendard_bold"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="총 0개"
                            android:textColor="#1685D4"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 안내 영역 -->
                    <LinearLayout
                        android:id="@+id/studentNoticeInfoArea"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:id="@+id/tvCurrentLectureName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_bold"
                            android:text=""
                            android:textColor="#111111"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNoticeDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="교수님이 등록한 강의 일정 및 출결 관련 공지를 확인할 수 있습니다."
                            android:textColor="#777777"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E4E4E4" />

                    <!-- 공지 목록 / 빈 화면 영역 -->
                    <FrameLayout
                        android:id="@+id/noticeListFrame"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <!-- Firebase 데이터가 있을 때 Kotlin에서 item을 추가하는 영역 -->
                        <ScrollView
                            android:id="@+id/studentNoticeScroll"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fillViewport="true"
                            android:visibility="visible">

                            <LinearLayout
                                android:id="@+id/studentNoticeList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingTop="8dp"
                                android:paddingBottom="16dp" />
                        </ScrollView>

                        <!-- Firebase 데이터가 없을 때 보여줄 화면 -->
                        <LinearLayout
                            android:id="@+id/emptyNoticeView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="24dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvEmptyNoticeTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/pretendard_bold"
                                android:text="등록된 공지가 없습니다"
                                android:textColor="#222222"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvEmptyNoticeSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:text="교수님이 공지를 등록하면 이곳에 표시됩니다."
                                android:textColor="#777777"
                                android:textSize="14sp" />
                        </LinearLayout>

                    </FrameLayout>
                </LinearLayout>

                <!-- 학생용 공지 상세 화면 -->
                <LinearLayout
                    android:id="@+id/studentNoticeDetailContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFFFFF"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/detailTopBar"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:background="#F2F5FA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageButton
                            android:id="@+id/btnBackToNoticeList"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@android:color/transparent"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_media_previous"
                            android:tint="#222222" />

                        <TextView
                            android:id="@+id/tvDetailPageTitle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/pretendard_bold"
                            android:gravity="center"
                            android:text="공지 상세"
                            android:textColor="#111111"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="44dp"
                            android:layout_height="44dp" />
                    </LinearLayout>

                    <ScrollView
                        android:id="@+id/detailScroll"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true">

                        <LinearLayout
                            android:id="@+id/detailContentArea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/tvDetailBadge"
                                android:layout_width="60dp"
                                android:layout_height="30dp"
                                android:background="#1685D4"
                                android:fontFamily="@font/pretendard_bold"
                                android:gravity="center"
                                android:text=""
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:fontFamily="@font/pretendard_bold"
                                android:text=""
                                android:textColor="#111111"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text=""
                                android:textColor="#777777"
                                android:textSize="13sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="18dp"
                                android:layout_marginBottom="18dp"
                                android:background="#E4E4E4" />

                            <TextView
                                android:id="@+id/tvDetailContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineSpacingExtra="5dp"
                                android:text=""
                                android:textColor="#333333"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </ScrollView>
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- 하단 메뉴  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="109dp"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <!-- 위쪽 버튼 영역: 65dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:background="#004B83"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBottomHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/home"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnBottomRefresh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/retry"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnBottomNotice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/bell"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnBottomSchedule"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/calendar"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnBottomLogout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/back"
                android:tint="#FFFFFF" />

        </LinearLayout>

        <!-- 아래쪽 영역: 44dp 그대로 유지 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#004B83" />

    </LinearLayout>


</LinearLayout>