<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainProfessorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:orientation="vertical">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:id="@+id/headerArea"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="130dp"
            android:layout_height="48dp"
            android:scaleType="fitStart"
            android:src="@drawable/nulogo" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/menu" />
    </LinearLayout>

    <!-- 날짜 / 교시 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDatePeriod"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="9dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="22dp">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/pretendard_medium"
                android:text=""
                android:textColor="#4A4A4A"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:text=""
                android:textColor="#4A4A4A"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 수업 정보 카드 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardClassInfo"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="9dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <!-- 수업 있을 때 -->
            <LinearLayout
                android:id="@+id/layoutClassInfoContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvClassName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_bold"
                    android:text=""
                    android:textColor="#004B83"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/tabler_clock"
                        android:tint="#555555" />

                    <TextView
                        android:id="@+id/tvClassTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/pretendard_medium"
                        android:text=""
                        android:textColor="#444444"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 수업 없을 때 -->
            <TextView
                android:id="@+id/tvNoClassInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_medium"
                android:text="현재 진행 중인 수업이 없습니다."
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:visibility="visible" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 메인 영역 -->
    <LinearLayout
        android:id="@+id/mainContentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <!-- 학생 출석 현황 표 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardStudentAttendanceTable"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="9dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <!-- 헤더 -->
                <LinearLayout
                    android:id="@+id/tableTopArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAttendanceListTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="학생 출석 현황"
                        android:textColor="#004B83"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStudentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_medium"
                        android:text=""
                        android:textColor="#777777"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAttendanceProcessNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/pretendard_medium"
                    android:text="출석 시작 후 학생 현황이 실시간으로 반영됩니다."
                    android:textColor="#7A7A7A"
                    android:textSize="11sp" />

                <!-- 테이블 헤더 (학생 있을 때만 표시) -->
                <LinearLayout
                    android:id="@+id/tableHeader"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#F4F7FB"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.45" android:fontFamily="@font/pretendard_bold" android:gravity="center" android:text="학번" android:textColor="#333333" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:fontFamily="@font/pretendard_bold" android:gravity="center" android:text="이름" android:textColor="#333333" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.75" android:fontFamily="@font/pretendard_bold" android:gravity="center" android:text="출석" android:textColor="#333333" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.75" android:fontFamily="@font/pretendard_bold" android:gravity="center" android:text="결석" android:textColor="#333333" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.75" android:fontFamily="@font/pretendard_bold" android:gravity="center" android:text="지각" android:textColor="#333333" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <View android:id="@+id/dividerTableHeader" android:layout_width="match_parent" android:layout_height="1dp" android:background="#E7E7E7" android:visibility="gone" />

                <!-- 학생 리스트 -->
                <ScrollView
                    android:id="@+id/scrollStudentAttendance"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:overScrollMode="ifContentScrolls"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/layoutStudentAttendanceRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <!-- 학생 데이터 없을 때 안내 -->
                <LinearLayout
                    android:id="@+id/layoutNoStudentData"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="출결 데이터가 없습니다."
                        android:textColor="#AAAAAA"
                        android:textSize="15sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/pretendard_medium"
                        android:text="출석 체크를 시작하면 학생 현황이 표시됩니다."
                        android:textColor="#BBBBBB"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 출석 제어 카드 (PIN + 출석체크 버튼) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardProfessorControlBefore15"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_marginBottom="12dp"
            android:visibility="visible"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="9dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/layoutPinArea"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FAFAFA"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/tvPinBoxTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/pretendard_bold"
                            android:text="학생에게 제공할 PIN"
                            android:textColor="#555555"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvPinGuide"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/pretendard_medium"
                            android:singleLine="true"
                            android:text="출석체크 시작 시 PIN이 표시되고 블루투스 출결이 활성화됩니다."
                            android:textColor="#777777"
                            android:textSize="9sp" />

                        <LinearLayout
                            android:id="@+id/layoutPinBoxes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:orientation="horizontal">

                            <TextView android:id="@+id/tvPinDigit1" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="8dp" android:background="#E5E5E5" android:fontFamily="@font/pretendard_bold" android:gravity="center" android:text="" android:textColor="#004B83" android:textSize="19sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvPinDigit2" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="8dp" android:background="#E5E5E5" android:fontFamily="@font/pretendard_bold" android:gravity="center" android:text="" android:textColor="#004B83" android:textSize="19sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvPinDigit3" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="8dp" android:background="#E5E5E5" android:fontFamily="@font/pretendard_bold" android:gravity="center" android:text="" android:textColor="#004B83" android:textSize="19sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvPinDigit4" android:layout_width="40dp" android:layout_height="40dp" android:background="#E5E5E5" android:fontFamily="@font/pretendard_bold" android:gravity="center" android:text="" android:textColor="#004B83" android:textSize="19sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnProfessorAttendanceCheck"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_attendance_button_blue"
                    android:fontFamily="@font/pretendard_bold"
                    android:gravity="center"
                    android:padding="0dp"
                    android:text="출석\n체크"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 호명 출석 버튼 -->
        <LinearLayout
            android:id="@+id/btnRollCallAttendance"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_attendance_button_blue"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/say"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:text="호명 출석"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 15분 이후 통계 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardProfessorControlAfter15"
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="9dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tvAfter15ClassName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_bold"
                    android:text=""
                    android:textColor="#004B83"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvAttendanceRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/pretendard_bold" android:text="" android:textColor="#015EB6" android:textSize="28sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/pretendard_medium" android:text="출석률" android:textColor="#777777" android:textSize="11sp" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="54dp" android:background="#E0E0E0" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvLateRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/pretendard_bold" android:text="" android:textColor="#9C27B0" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/pretendard_medium" android:text="지각률" android:textColor="#777777" android:textSize="11sp" />
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="54dp" android:background="#E0E0E0" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvAbsentRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/pretendard_bold" android:text="" android:textColor="#D00000" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/pretendard_medium" android:text="결석률" android:textColor="#777777" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- UWB 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardUwbMiddleCheck"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="9dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvUwbTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/pretendard_bold" android:text="UWB 중간 출석 체크" android:textColor="#004B83" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvUwbDescription" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/pretendard_medium" android:text="5분 간격 체크 · 3회 이상 미인증 시 결석 처리" android:textColor="#777777" android:textSize="11sp" />
                </LinearLayout>

                <TextView android:id="@+id/tvUwbCheckCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/pretendard_bold" android:text="" android:textColor="#015EB6" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- 하단 메뉴 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="109dp"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#004B83"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton android:id="@+id/btnBottomHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:padding="14dp" android:scaleType="centerInside" android:src="@drawable/home" android:tint="#FFFFFF" />
            <ImageButton android:id="@+id/btnBottomRefresh" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:padding="14dp" android:scaleType="centerInside" android:src="@drawable/retry" android:tint="#FFFFFF" />
            <ImageButton android:id="@+id/btnBottomNotice" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:padding="14dp" android:scaleType="centerInside" android:src="@drawable/bell" android:tint="#FFFFFF" />
            <ImageButton android:id="@+id/btnBottomSchedule" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:padding="14dp" android:scaleType="centerInside" android:src="@drawable/calendar" android:tint="#FFFFFF" />
            <ImageButton android:id="@+id/btnBottomLogout" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:padding="14dp" android:scaleType="centerInside" android:src="@drawable/back" android:tint="#FFFFFF" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="49dp" android:background="#004B83" />
    </LinearLayout>

</LinearLayout>