<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/termsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- 상단 빈 상태바 느낌 영역 -->
    <View
        android:id="@+id/statusArea"
        android:layout_width="match_parent"
        android:layout_height="51dp"
        android:background="#FFFFFF" />

    <!-- 상단 파란 헤더 -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="41dp"
        android:background="@color/primarybase">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="뒤로가기"
            android:padding="14dp"
            android:src="@drawable/arrow"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvTopTitle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:fontFamily="@font/pretendard_bold"
            android:gravity="center"
            android:text="이용 약관"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

    </FrameLayout>

    <ScrollView
        android:id="@+id/termsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/termsContentArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="37dp"
            android:paddingEnd="28dp"
            android:paddingBottom="40dp">

            <TextView
                android:id="@+id/tvTermsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard_bold"
                android:text="가천대학교 전자출결 서비스 이용 약관"
                android:textColor="@color/primarybase"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTermsDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/pretendard_regular"
                android:lineSpacingExtra="5dp"
                android:text="본 약관은 가천대학교 전자출결 앱을 이용하는 학생 및 교수자의 서비스 이용 조건과 개인정보 처리, 출결 인증 방식, 부정 출석 방지 기준 등을 안내하기 위한 약관입니다."
                android:textColor="#444444"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTermsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/pretendard_regular"
                android:lineSpacingExtra="6dp"
                android:textColor="#333333"
                android:textSize="13sp"
                android:text="제1조 목적&#10;본 약관은 가천대학교 전자출결 앱의 회원가입, 로그인, 수업 출석 인증, 인증 결석 신청 및 출결 현황 확인 서비스 이용에 필요한 사항을 정하는 것을 목적으로 합니다.&#10;&#10;제2조 회원 정보 입력&#10;회원은 가천 포털 계정의 아이디, 비밀번호, 이메일 정보를 정확하게 입력해야 합니다. 타인의 계정을 도용하거나 허위 정보를 입력할 경우 서비스 이용이 제한될 수 있습니다.&#10;&#10;제3조 출결 인증 방식&#10;전자출결 앱은 블루투스, PIN 번호, UWB 기반 위치 확인 등 수업 환경에 따라 다양한 방식으로 출석을 인증할 수 있습니다. 사용자는 정상적인 출석 확인을 위해 수업 시간 내 앱 실행 및 인증 절차에 협조해야 합니다.&#10;&#10;제4조 부정 출석 방지&#10;대리 출석, 허위 인증, 위치 조작, 타인 계정 사용 등 부정한 방법으로 출석을 시도하는 행위는 금지됩니다. 부정 출석이 확인될 경우 해당 수업의 출결 상태가 변경될 수 있으며, 학교 규정에 따라 불이익이 발생할 수 있습니다.&#10;&#10;제5조 개인정보 수집 및 이용&#10;서비스 제공을 위해 학번, 이름, 포털 아이디, 이메일, 수강 과목, 출결 상태, 인증 시간, 인증 방식 등의 정보가 수집 및 이용될 수 있습니다. 수집된 정보는 출결 관리 목적 외의 용도로 사용되지 않습니다.&#10;&#10;제6조 위치 및 기기 정보 이용&#10;출석 인증 과정에서 강의실 내 출석 여부 확인을 위해 블루투스, UWB, 기기 식별 정보 등이 활용될 수 있습니다. 해당 정보는 출석 확인 및 부정 출석 방지 목적으로만 사용됩니다.&#10;&#10;제7조 인증 결석 신청&#10;사용자는 질병, 공결, 학교 행사 등 정당한 사유가 있는 경우 인증 결석 신청 기능을 통해 증빙 자료를 제출할 수 있습니다. 승인 여부는 담당 교수자 또는 학교 기준에 따라 결정됩니다.&#10;&#10;제8조 서비스 이용 제한&#10;앱을 비정상적으로 조작하거나 출결 데이터를 임의로 변경하려는 행위가 확인될 경우 서비스 이용이 제한될 수 있습니다.&#10;&#10;제9조 약관 동의&#10;회원가입을 진행하는 경우 본 약관의 내용을 확인하고 동의한 것으로 간주됩니다." />

        </LinearLayout>

    </ScrollView>

    <!-- 하단 로고 영역 -->
    <LinearLayout
        android:id="@+id/bottomLogoArea"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="#E9EAEC"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="23dp">

        <ImageView
            android:id="@+id/ivBottomLogo"
            android:layout_width="122dp"
            android:layout_height="44dp"
            android:contentDescription="가천대학교 로고"
            android:scaleType="fitStart"
            android:src="@drawable/nulogo" />

    </LinearLayout>

</LinearLayout>