<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/noticeProfessorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:orientation="vertical">

    <!-- 상단 영역 -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="124dp"
        android:gravity="bottom|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="122dp"
            android:layout_height="44dp"
            android:scaleType="fitStart"
            android:src="@drawable/nulogo" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:src="@drawable/menu"
            android:tint="#555555" />
    </LinearLayout>

    <!-- 메인 콘텐츠 -->
    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <!-- 제목 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/titleCard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvProfessorNoticeTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/pretendard_bold"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="강의 공지"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <!-- 흰색 큰 박스 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/professorNoticeMainCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:id="@+id/professorNoticeFrame"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- ========================= -->
                <!-- 1. 교수용 공지 목록 화면 -->
                <!-- ========================= -->
                <FrameLayout
                    android:id="@+id/professorNoticeListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <!-- 내부 상단바 -->
                        <LinearLayout
                            android:id="@+id/professorNoticeTopBar"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:background="#F2F5FA"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:id="@+id/tvProfessorNoticePageTitle"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:fontFamily="@font/pretendard_bold"
                                android:gravity="center_vertical"
                                android:text="공지 관리"
                                android:textColor="#111111"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvProfessorNoticeCount"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="#E4F2FF"
                                android:fontFamily="@font/pretendard_bold"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="등록 3개"
                                android:textColor="#1685D4"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- 안내 영역 -->
                        <LinearLayout
                            android:id="@+id/professorNoticeInfoArea"
                            android:layout_width="match_parent"
                            android:layout_height="78dp"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <TextView
                                android:id="@+id/tvProfessorLectureName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/pretendard_bold"
                                android:text="머신러닝 및 실습"
                                android:textColor="#111111"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvProfessorNoticeDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="강의 일정, 출석 방식, PIN 안내 등 학생에게 전달할 공지를 등록할 수 있습니다."
                                android:textColor="#777777"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E4E4E4" />

                        <!-- Kotlin에서 RecyclerView로 교체 가능 -->
                        <ScrollView
                            android:id="@+id/professorNoticeScroll"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:fillViewport="true">

                            <LinearLayout
                                android:id="@+id/professorNoticeList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingTop="8dp"
                                android:paddingBottom="96dp">

                                <!-- 교수 공지 아이템 1 -->
                                <LinearLayout
                                    android:id="@+id/itemProfessorNotice1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="#FFFFFF"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:orientation="vertical"
                                    android:paddingStart="16dp"
                                    android:paddingTop="16dp"
                                    android:paddingEnd="16dp"
                                    android:paddingBottom="16dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/tvProfessorNoticeBadge1"
                                            android:layout_width="54dp"
                                            android:layout_height="28dp"
                                            android:background="#1685D4"
                                            android:fontFamily="@font/pretendard_bold"
                                            android:gravity="center"
                                            android:text="중요"
                                            android:textColor="#FFFFFF"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvProfessorNoticeDate1"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="10dp"
                                            android:layout_weight="1"
                                            android:gravity="end"
                                            android:text="2026-05-11"
                                            android:textColor="#888888"
                                            android:textSize="13sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/tvProfessorNoticeItemTitle1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:fontFamily="@font/pretendard_bold"
                                        android:text="5월 13일 수업 일정 변경 안내"
                                        android:textColor="#111111"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvProfessorNoticeItemContent1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="7dp"
                                        android:ellipsize="end"
                                        android:maxLines="2"
                                        android:text="강의실 변경 및 출석 체크 시간이 조정될 예정입니다. 수업 전 반드시 확인 바랍니다."
                                        android:textColor="#666666"
                                        android:textSize="14sp" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:gravity="end"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/btnEditNotice1"
                                            android:layout_width="58dp"
                                            android:layout_height="30dp"
                                            android:background="#F2F5FA"
                                            android:gravity="center"
                                            android:text="수정"
                                            android:textColor="#333333"
                                            android:textSize="13sp" />

                                        <TextView
                                            android:id="@+id/btnDeleteNotice1"
                                            android:layout_width="58dp"
                                            android:layout_height="30dp"
                                            android:layout_marginStart="8dp"
                                            android:background="#FFF0F0"
                                            android:gravity="center"
                                            android:text="삭제"
                                            android:textColor="#D00000"
                                            android:textSize="13sp" />
                                    </LinearLayout>
                                </LinearLayout>

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="#E4E4E4" />

                                <!-- 교수 공지 아이템 2 -->
                                <LinearLayout
                                    android:id="@+id/itemProfessorNotice2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="#FFFFFF"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:orientation="vertical"
                                    android:paddingStart="16dp"
                                    android:paddingTop="16dp"
                                    android:paddingEnd="16dp"
                                    android:paddingBottom="16dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/tvProfessorNoticeBadge2"
                                            android:layout_width="54dp"
                                            android:layout_height="28dp"
                                            android:background="#F2F5FA"
                                            android:fontFamily="@font/pretendard_bold"
                                            android:gravity="center"
                                            android:text="일반"
                                            android:textColor="#555555"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvProfessorNoticeDate2"
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="10dp"
                                            android:layout_weight="1"
                                            android:gravity="end"
                                            android:text="2026-05-09"
                                            android:textColor="#888888"
                                            android:textSize="13sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/tvProfessorNoticeItemTitle2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:fontFamily="@font/pretendard_bold"
                                        android:text="PIN 출석 입력 관련 안내"
                                        android:textColor="#111111"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvProfessorNoticeItemContent2"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="7dp"
                                        android:ellipsize="end"
                                        android:maxLines="2"
                                        android:text="블루투스 출석이 정상적으로 되지 않은 학생은 교수님 안내에 따라 PIN을 입력해주시기 바랍니다."
                                        android:textColor="#666666"
                                        android:textSize="14sp" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:gravity="end"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/btnEditNotice2"
                                            android:layout_width="58dp"
                                            android:layout_height="30dp"
                                            android:background="#F2F5FA"
                                            android:gravity="center"
                                            android:text="수정"
                                            android:textColor="#333333"
                                            android:textSize="13sp" />

                                        <TextView
                                            android:id="@+id/btnDeleteNotice2"
                                            android:layout_width="58dp"
                                            android:layout_height="30dp"
                                            android:layout_marginStart="8dp"
                                            android:background="#FFF0F0"
                                            android:gravity="center"
                                            android:text="삭제"
                                            android:textColor="#D00000"
                                            android:textSize="13sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                        </ScrollView>
                    </LinearLayout>

                    <!-- 오른쪽 아래 작성 버튼 -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnAddNoticeCard"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="24dp"
                        app:cardBackgroundColor="#1685D4"
                        app:cardCornerRadius="36dp"
                        app:cardElevation="8dp">

                        <TextView
                            android:id="@+id/btnAddNotice"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="42sp" />
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <!-- ========================= -->
                <!-- 2. 교수용 공지 작성 화면 -->
                <!-- Kotlin에서 + 버튼 클릭 시 visible -->
                <!-- ========================= -->
                <LinearLayout
                    android:id="@+id/professorNoticeWriteContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFFFFF"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 작성 화면 상단바 -->
                    <LinearLayout
                        android:id="@+id/writeTopBar"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:background="#F2F5FA"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageButton
                            android:id="@+id/btnBackToProfessorNoticeList"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@android:color/transparent"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_media_previous"
                            android:tint="#222222" />

                        <TextView
                            android:id="@+id/tvWritePageTitle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/pretendard_bold"
                            android:gravity="center"
                            android:text="공지 작성"
                            android:textColor="#111111"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="44dp"
                            android:layout_height="44dp" />
                    </LinearLayout>

                    <ScrollView
                        android:id="@+id/writeScroll"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true">

                        <LinearLayout
                            android:id="@+id/writeContentArea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- 안내 문구 -->
                            <LinearLayout
                                android:id="@+id/writeGuideArea"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#FFFFFF"
                                android:orientation="vertical"
                                android:paddingStart="18dp"
                                android:paddingTop="18dp"
                                android:paddingEnd="18dp"
                                android:paddingBottom="16dp">

                                <TextView
                                    android:id="@+id/tvWriteGuideTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/pretendard_bold"
                                    android:text="학생들에게 전달할 공지를 작성해주세요."
                                    android:textColor="#111111"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvWriteGuideDesc"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:text="등록된 공지는 백엔드에 저장되며, 학생용 강의 공지 페이지에서 확인할 수 있습니다."
                                    android:textColor="#777777"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#D6D6D6" />

                            <!-- 강의 선택 -->
                            <LinearLayout
                                android:id="@+id/lectureSelectRow"
                                android:layout_width="match_parent"
                                android:layout_height="78dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="96dp"
                                    android:layout_height="match_parent"
                                    android:background="#F3F3F3"
                                    android:fontFamily="@font/pretendard_bold"
                                    android:gravity="center"
                                    android:text="강의"
                                    android:textColor="#111111"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:id="@+id/lectureSelectBox"
                                    android:layout_width="0dp"
                                    android:layout_height="50dp"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginStart="14dp"
                                    android:layout_marginEnd="14dp"
                                    android:layout_weight="1"
                                    android:background="#FFFFFF"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp">

                                    <TextView
                                        android:id="@+id/tvSelectedLecture"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:gravity="center_vertical"
                                        android:text="머신러닝 및 실습"
                                        android:textColor="#111111"
                                        android:textSize="16sp" />

                                    <TextView
                                        android:id="@+id/tvLectureArrow"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:text="⌄"
                                        android:textColor="#777777"
                                        android:textSize="26sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#D6D6D6" />

                            <!-- 공지 유형 -->
                            <LinearLayout
                                android:id="@+id/noticeTypeRow"
                                android:layout_width="match_parent"
                                android:layout_height="78dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="96dp"
                                    android:layout_height="match_parent"
                                    android:background="#F3F3F3"
                                    android:fontFamily="@font/pretendard_bold"
                                    android:gravity="center"
                                    android:text="유형"
                                    android:textColor="#111111"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <RadioGroup
                                    android:id="@+id/rgNoticeType"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="14dp"
                                    android:layout_marginEnd="14dp"
                                    android:layout_weight="1"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <RadioButton
                                        android:id="@+id/rbNoticeNormal"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:buttonTint="#1685D4"
                                        android:checked="true"
                                        android:text="일반"
                                        android:textColor="#111111"
                                        android:textSize="15sp" />

                                    <RadioButton
                                        android:id="@+id/rbNoticeImportant"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="18dp"
                                        android:buttonTint="#1685D4"
                                        android:text="중요"
                                        android:textColor="#111111"
                                        android:textSize="15sp" />
                                </RadioGroup>
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#D6D6D6" />

                            <!-- 제목 입력 -->
                            <LinearLayout
                                android:id="@+id/noticeTitleRow"
                                android:layout_width="match_parent"
                                android:layout_height="82dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="96dp"
                                    android:layout_height="match_parent"
                                    android:background="#F3F3F3"
                                    android:fontFamily="@font/pretendard_bold"
                                    android:gravity="center"
                                    android:text="제목"
                                    android:textColor="#111111"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <EditText
                                    android:id="@+id/etNoticeTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="52dp"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginStart="14dp"
                                    android:layout_marginEnd="14dp"
                                    android:layout_weight="1"
                                    android:background="#FFFFFF"
                                    android:hint="공지 제목을 입력해주세요."
                                    android:inputType="text"
                                    android:maxLength="50"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="10dp"
                                    android:textColor="#111111"
                                    android:textColorHint="#AAAAAA"
                                    android:textSize="15sp" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#D6D6D6" />

                            <!-- 내용 입력 -->
                            <LinearLayout
                                android:id="@+id/noticeContentRow"
                                android:layout_width="match_parent"
                                android:layout_height="220dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="96dp"
                                    android:layout_height="match_parent"
                                    android:background="#F3F3F3"
                                    android:fontFamily="@font/pretendard_bold"
                                    android:gravity="center"
                                    android:text="내용"
                                    android:textColor="#111111"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <EditText
                                    android:id="@+id/etNoticeContent"
                                    android:layout_width="0dp"
                                    android:layout_height="180dp"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginStart="14dp"
                                    android:layout_marginEnd="14dp"
                                    android:layout_weight="1"
                                    android:background="#FFFFFF"
                                    android:gravity="top|start"
                                    android:hint="공지 내용을 입력해주세요."
                                    android:inputType="textMultiLine"
                                    android:maxLength="1000"
                                    android:minLines="6"
                                    android:padding="10dp"
                                    android:textColor="#111111"
                                    android:textColorHint="#AAAAAA"
                                    android:textSize="15sp" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#D6D6D6" />

                            <!-- 공개 여부 -->
                            <LinearLayout
                                android:id="@+id/noticeOpenRow"
                                android:layout_width="match_parent"
                                android:layout_height="78dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="96dp"
                                    android:layout_height="match_parent"
                                    android:background="#F3F3F3"
                                    android:fontFamily="@font/pretendard_bold"
                                    android:gravity="center"
                                    android:text="공개"
                                    android:textColor="#111111"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <CheckBox
                                    android:id="@+id/cbNoticeOpen"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="14dp"
                                    android:layout_marginEnd="14dp"
                                    android:layout_weight="1"
                                    android:buttonTint="#1685D4"
                                    android:checked="true"
                                    android:gravity="center_vertical"
                                    android:text="작성 즉시 학생에게 공개"
                                    android:textColor="#111111"
                                    android:textSize="15sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/btnSubmitNotice"
                                android:layout_width="match_parent"
                                android:layout_height="68dp"
                                android:background="#1685D4"
                                android:fontFamily="@font/pretendard_bold"
                                android:gravity="center"
                                android:text="공지 등록"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </ScrollView>
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- 하단 메뉴 -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/primarybase"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBottomHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/home"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/retry"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomNotice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/bell"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomSchedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/calendar"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomLogout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/back"
            android:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>