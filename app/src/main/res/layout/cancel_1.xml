<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cancelStudentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEFEF"
    android:orientation="vertical">

    <!-- 상단 영역 -->
    <LinearLayout
        android:id="@+id/topHeader"
        android:layout_width="match_parent"
        android:layout_height="124dp"
        android:gravity="bottom|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="122dp"
            android:layout_height="44dp"
            android:scaleType="fitStart"
            android:src="@drawable/nulogo" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:src="@drawable/menu"
            android:tint="#555555" />
    </LinearLayout>

    <!-- 메인 콘텐츠 -->
    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <!-- 제목 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/titleCard"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvCancelTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/pretendard_bold"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="휴보강"
                android:textColor="#111111"
                android:textSize="17sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <!-- 흰색 큰 박스 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cancelMainCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:id="@+id/studentCancelContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- 내부 상단바 -->
                <LinearLayout
                    android:id="@+id/cancelTopBar"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="#F2F5FA"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/tvStudentCancelPageTitle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/pretendard_bold"
                        android:gravity="center_vertical"
                        android:text="휴보강 내역"
                        android:textColor="#111111"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCancelCount"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="#E4F2FF"
                        android:fontFamily="@font/pretendard_bold"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="총 4건"
                        android:textColor="#1685D4"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 안내 영역 -->
                <LinearLayout
                    android:id="@+id/studentCancelInfoArea"
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/tvStudentScheduleFilter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="내 시간표 기준 전체 휴보강"
                        android:textColor="#111111"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStudentCancelDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="휴강, 대면 보강, 비대면 보강, MOOC 마감기한을 확인할 수 있습니다."
                        android:textColor="#777777"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E4E4E4" />

                <ScrollView
                    android:id="@+id/studentCancelScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/studentCancelList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- ========================= -->
                        <!-- 1. 일반 대면 보강 -->
                        <!-- ========================= -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/itemOfflineMakeup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvOfflineMakeupBadge"
                                        android:layout_width="72dp"
                                        android:layout_height="28dp"
                                        android:background="#1685D4"
                                        android:fontFamily="@font/pretendard_bold"
                                        android:gravity="center"
                                        android:text="대면보강"
                                        android:textColor="#FFFFFF"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvOfflineMakeupClassName"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/pretendard_bold"
                                        android:text="머신러닝 및 실습"
                                        android:textColor="#111111"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvOfflineMakeupProfessor"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:text="이상웅 교수 · AI공학관 305호"
                                    android:textColor="#777777"
                                    android:textSize="13sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="100dp"
                                        android:layout_weight="1"
                                        android:background="#FFF2F2"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="8dp">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/pretendard_bold"
                                            android:text="휴강"
                                            android:textColor="#D00000"
                                            android:textSize="14sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvOfflineCancelDate"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="8dp"
                                            android:fontFamily="@font/pretendard_bold"
                                            android:text="05.15 목"
                                            android:textColor="#111111"
                                            android:textSize="21sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvOfflineCancelTime"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:text="10:00 - 11:50"
                                            android:textColor="#666666"
                                            android:textSize="13sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:layout_width="42dp"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:text="→"
                                        android:textColor="#1685D4"
                                        android:textSize="26sp"
                                        android:textStyle="bold" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="100dp"
                                        android:layout_weight="1"
                                        android:background="#F0F8FF"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="8dp">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/pretendard_bold"
                                            android:text="보강"
                                            android:textColor="#1685D4"
                                            android:textSize="14sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvOfflineMakeupDate"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="8dp"
                                            android:fontFamily="@font/pretendard_bold"
                                            android:text="05.22 목"
                                            android:textColor="#111111"
                                            android:textSize="21sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvOfflineMakeupTime"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:text="18:00 - 19:50"
                                            android:textColor="#666666"
                                            android:textSize="13sp" />
                                    </LinearLayout>
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvOfflineMakeupRoom"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:background="#F7F7F7"
                                    android:gravity="center_vertical"
                                    android:padding="10dp"
                                    android:text="보강 강의실 : AI공학관 305호"
                                    android:textColor="#555555"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- ========================= -->
                        <!-- 2. 휴강만, 보강 없음 -->
                        <!-- ========================= -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/itemOnlyCancel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvOnlyCancelBadge"
                                        android:layout_width="72dp"
                                        android:layout_height="28dp"
                                        android:background="#D00000"
                                        android:fontFamily="@font/pretendard_bold"
                                        android:gravity="center"
                                        android:text="휴강"
                                        android:textColor="#FFFFFF"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvOnlyCancelClassName"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/pretendard_bold"
                                        android:text="소프트웨어공학"
                                        android:textColor="#111111"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvOnlyCancelProfessor"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:text="김가천 교수 · 비전타워 402호"
                                    android:textColor="#777777"
                                    android:textSize="13sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="94dp"
                                    android:layout_marginTop="16dp"
                                    android:background="#FFF2F2"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvOnlyCancelDate"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/pretendard_bold"
                                        android:text="05.16 금"
                                        android:textColor="#D00000"
                                        android:textSize="24sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvOnlyCancelTime"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="5dp"
                                        android:text="09:00 - 10:50"
                                        android:textColor="#555555"
                                        android:textSize="14sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvOnlyCancelNotice"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:background="#F7F7F7"
                                    android:padding="10dp"
                                    android:text="해당 수업은 보강 없이 휴강 처리됩니다."
                                    android:textColor="#555555"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- ========================= -->
                        <!-- 3. ZOOM / WEBEX 비대면 보강 -->
                        <!-- ========================= -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/itemOnlineMakeup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvOnlineMakeupBadge"
                                        android:layout_width="82dp"
                                        android:layout_height="28dp"
                                        android:background="#6A4CFF"
                                        android:fontFamily="@font/pretendard_bold"
                                        android:gravity="center"
                                        android:text="ZOOM"
                                        android:textColor="#FFFFFF"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvOnlineMakeupClassName"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/pretendard_bold"
                                        android:text="데이터베이스"
                                        android:textColor="#111111"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvOnlineMakeupProfessor"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:text="박가천 교수 · AI공학관 201호"
                                    android:textColor="#777777"
                                    android:textSize="13sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="100dp"
                                        android:layout_weight="1"
                                        android:background="#FFF2F2"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="8dp">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="휴강"
                                            android:textColor="#D00000"
                                            android:textSize="14sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvOnlineCancelDate"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="8dp"
                                            android:fontFamily="@font/pretendard_bold"
                                            android:text="05.20 화"
                                            android:textColor="#111111"
                                            android:textSize="21sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvOnlineCancelTime"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:text="13:00 - 14:50"
                                            android:textColor="#666666"
                                            android:textSize="13sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:layout_width="42dp"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:text="→"
                                        android:textColor="#6A4CFF"
                                        android:textSize="26sp"
                                        android:textStyle="bold" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="100dp"
                                        android:layout_weight="1"
                                        android:background="#F4F1FF"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="8dp">

                                        <TextView
                                            android:id="@+id/tvOnlinePlatform"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="비대면 보강"
                                            android:textColor="#6A4CFF"
                                            android:textSize="14sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvOnlineMakeupDate"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="8dp"
                                            android:fontFamily="@font/pretendard_bold"
                                            android:text="05.23 금"
                                            android:textColor="#111111"
                                            android:textSize="21sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvOnlineMakeupTime"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:text="19:00 - 20:30"
                                            android:textColor="#666666"
                                            android:textSize="13sp" />
                                    </LinearLayout>
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvOnlineLinkGuide"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:background="#F7F7F7"
                                    android:padding="10dp"
                                    android:text="접속 링크는 수업 시작 전 강의 공지 또는 LMS에서 확인하세요."
                                    android:textColor="#555555"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- ========================= -->
                        <!-- 4. MOOC 보강 -->
                        <!-- ========================= -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/itemMoocMakeup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tvMoocMakeupBadge"
                                        android:layout_width="82dp"
                                        android:layout_height="28dp"
                                        android:background="#00A36C"
                                        android:fontFamily="@font/pretendard_bold"
                                        android:gravity="center"
                                        android:text="MOOC"
                                        android:textColor="#FFFFFF"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tvMoocMakeupClassName"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/pretendard_bold"
                                        android:text="인공지능개론"
                                        android:textColor="#111111"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvMoocMakeupProfessor"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="7dp"
                                    android:text="최가천 교수 · 온라인 강의"
                                    android:textColor="#777777"
                                    android:textSize="13sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="100dp"
                                        android:layout_weight="1"
                                        android:background="#FFF2F2"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="8dp">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="휴강"
                                            android:textColor="#D00000"
                                            android:textSize="14sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvMoocCancelDate"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="8dp"
                                            android:fontFamily="@font/pretendard_bold"
                                            android:text="05.21 수"
                                            android:textColor="#111111"
                                            android:textSize="21sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvMoocCancelTime"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:text="15:00 - 16:50"
                                            android:textColor="#666666"
                                            android:textSize="13sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:layout_width="42dp"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:text="→"
                                        android:textColor="#00A36C"
                                        android:textSize="26sp"
                                        android:textStyle="bold" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="100dp"
                                        android:layout_weight="1"
                                        android:background="#EFFFF8"
                                        android:gravity="center"
                                        android:orientation="vertical"
                                        android:padding="8dp">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="수강 마감"
                                            android:textColor="#00A36C"
                                            android:textSize="14sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvMoocDeadlineDate"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="8dp"
                                            android:fontFamily="@font/pretendard_bold"
                                            android:text="05.28 수"
                                            android:textColor="#111111"
                                            android:textSize="21sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/tvMoocDeadlineTime"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="4dp"
                                            android:text="23:59까지"
                                            android:textColor="#666666"
                                            android:textSize="13sp" />
                                    </LinearLayout>
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvMoocGuide"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:background="#F7F7F7"
                                    android:padding="10dp"
                                    android:text="마감기한 전까지 MOOC 강의를 수강해야 출석 인정됩니다."
                                    android:textColor="#555555"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- 데이터 없을 때 -->
                        <LinearLayout
                            android:id="@+id/emptyCancelArea"
                            android:layout_width="match_parent"
                            android:layout_height="260dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="등록된 휴보강이 없습니다."
                                android:textColor="#999999"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="내 시간표에 해당하는 휴보강만 표시됩니다."
                                android:textColor="#BBBBBB"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- 하단 메뉴 -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@color/primarybase"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton

            android:id="@+id/btnBottomHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/home"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/retry"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomNotice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/bell"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomSchedule"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/calendar"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnBottomLogout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="26dp"
            android:src="@drawable/back"
            android:tint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>